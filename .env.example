# Overpass API endpoint (defaults to main Overpass interpreter)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Force offline mock mode (loads sample fixtures without network access)
MOCK_MODE=False

# Path to local municipal GIS datasets (defaults to ../MapData)
MAP_DATA_DIR=../MapData

# Local cache directory for Overpass queries
CACHE_DIR=./cache
